# ============================================================
#  Copiar a .env y cambiar TODAS las contrasenas.
#  El archivo .env NO se sube al repositorio (ver .gitignore).
# ============================================================

# --- bootstrap del cluster -----------------------------------
# PRIMER arranque (cluster vacio):   --wsrep-new-cluster
# Arranques POSTERIORES:             dejar vacio
BOOTSTRAP_ARGS=--wsrep-new-cluster

# --- base de datos de la aplicacion --------------------------
APP_DB=biblioteca

# --- credenciales --------------------------------------------
ROOT_PASSWORD=cambiar_root_2026
ADMIN_PASSWORD=cambiar_admin_2026
REPL_PASSWORD=cambiar_repl_2026
APP_PASSWORD=cambiar_app_2026
MONITOR_PASSWORD=cambiar_monitor_2026
BENCH_PASSWORD=cambiar_bench_2026

# --- parametros de benchmark (usados por scripts/bench.sh) ---
BENCH_HOST=haproxy
BENCH_PORT=3306
BENCH_TABLES=10
BENCH_TABLE_SIZE=100000
BENCH_TIME=60
